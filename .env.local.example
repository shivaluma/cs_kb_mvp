# Local process overrides.
# Makefile loads .env first, then .env.local, so values here win when running
# `make api`, `make ai`, or `make web` outside Docker.

# Use your cloud Postgres connection string here if it differs from .env.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Local Go API should call the local AI service, not Docker service DNS `ai`.
AI_BASE_URL=http://localhost:8090

# Use cloud Meilisearch if Docker is not running. If you still run Meili locally,
# keep http://localhost:7700.
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key

# Python AI service uses this. Point to cloud Qdrant when not using Docker.
QDRANT_URL=http://localhost:6333
